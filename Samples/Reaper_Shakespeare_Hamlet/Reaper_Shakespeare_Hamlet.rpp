      FADEIN 0 0 0 0 0 0 0
      FADEOUT 0 0 0 0 0 0 0
      MUTE 0 0
      SEL 0
      IGUID {07D9F114-7C04-4E97-B276-81994BFB5FE1}
      IID 36389
      <NOTES
        |--we shall have him a piece of a carrion: Lord an he had lain i' the ground two years he would not have smelled.
      >
      IMGRESOURCEFLAGS 11
    >
    <ITEM
      POSITION 1006.5
