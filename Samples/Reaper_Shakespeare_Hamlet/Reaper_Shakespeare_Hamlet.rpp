  MARKER 4 44.5 Category=Act5_Scene1_Graveyard 0 0 1 R {BEC2FDEB-2763-4011-9A24-9738743D24E7} 0 2
  MARKER 89 44.5 Category=Act5_Scene1_Graveyard 1 26666928 1 R {023EE1B0-7DDD-45EE-A0B7-2E3A0D8B8281} 0 1
  MARKER 89 1332.5 "" 1
  MARKER 5 46.5 "Speaker=First Clown" 0 0 1 R {406E254E-6DE1-42E4-8250-7700133A2D60} 0 2
  MARKER 6 46.5 "Speaker=First Clown" 0 0 1 R {92CC6E44-16E0-408D-95B6-C79BAEB3BC6E} 0 2
  MARKER 2 47.5 "Entry=Is she to be buried in Christian burial that wilfully seeks her own salvation?" 1 21997311 1 R {8986045B-4E83-4B3A-9781-05B4CA2C48BA} 0 1
  MARKER 2 57.5 "" 1
  MARKER 7 61.5 "Speaker=Second Clown" 0 0 1 R {1564684B-C3C8-4FA8-B99F-8F99D93326F5} 0 2
  MARKER 8 61.5 "Speaker=Second Clown" 0 0 1 R {8A2C5B1A-0DE9-4AF0-9D37-FF1D29255AF3} 0 2
  MARKER 3 62.5 "Entry=I tell thee she is; and therefore make her grave straight: the crowner hath sat on her and finds it Christian burial." 1 21997311 1 R {9CE1F6E1-8C8C-41E5-BA9E-075960651C3E} 0 1
  MARKER 3 72.5 "" 1
  MARKER 9 76.5 "Speaker=First Clown" 0 0 1 R {DEE967B4-EF11-474E-83B0-507C1020CE4B} 0 2
  MARKER 10 76.5 "Speaker=First Clown" 0 0 1 R {FA033217-32F4-4F0E-ABA9-9E27A044976B} 0 2
  MARKER 4 77.5 "Entry=How can that be unless she drowned herself in her own defence?" 1 21997311 1 R {DF5F4915-9DEC-4078-841A-A8CDAEC4BCA5} 0 1
  MARKER 4 87.5 "" 1
  MARKER 11 91.5 "Speaker=Second Clown" 0 0 1 R {6BA0A2E8-947E-402C-88A4-D5A5ECEC22DD} 0 2
  MARKER 12 91.5 "Speaker=Second Clown" 0 0 1 R {B31AD002-AC46-4102-8E31-641085D140F2} 0 2
  MARKER 5 92.5 "Entry=Why 'tis found so." 1 21997311 1 R {01B6DA2C-5777-42C5-A96E-5CCEDDAE1EA3} 0 1
  MARKER 5 102.5 "" 1
  MARKER 13 106.5 "Speaker=First Clown" 0 0 1 R {55350977-0BBB-4CE6-843C-4D575469BA94} 0 2
  MARKER 14 106.5 "Speaker=First Clown" 0 0 1 R {7D4E2C93-339C-4EC5-859C-A11BF5F689C0} 0 2
  MARKER 6 107.5 "Entry=It must be se offendendo; it cannot be else. For here lies the point: if I drown myself wittingly it argues an act: and an act hath three branches--it is to act to do to perform: argal she drowned herself wittingly." 1 21997311 1 R {86FDD68E-B5DB-4B70-B02A-EB2CD45F332B} 0 1
  MARKER 6 117.5 "" 1
  MARKER 15 121.5 "Speaker=Second Clown" 0 0 1 R {D453F325-B6A8-490A-A39E-BA01FEDC0836} 0 2
  MARKER 16 121.5 "Speaker=Second Clown" 0 0 1 R {8A70478A-BE4B-4CFF-8A59-C664738F19AA} 0 2
  MARKER 7 122.5 "Entry=Nay but hear you Goodman Delver--" 1 21997311 1 R {8511A949-DF4F-4995-9224-731F884BDAAE} 0 1
  MARKER 7 132.5 "" 1
  MARKER 17 136.5 "Speaker=good: or if he come to the water and drown himself" 0 0 1 R {0BA4D1C0-0347-47EA-8102-662745B9B81B} 0 2
  MARKER 18 136.5 "Speaker=good: or if he come to the water and drown himself" 0 0 1 R {945E4538-948C-463F-A898-AED8E1183DA7} 0 2
  MARKER 8 137.5 "Entry=Give me leave. Here lies the water; good: here stands the man; good: if the man go to this water and drown himself" 1 21997311 1 R {257B1CD4-7B0F-45B8-84DB-780E4625A3FA} 0 1
  MARKER 8 147.5 "" 1
  MARKER 19 151.5 "Speaker=Second Clown" 0 0 1 R {CF07E4B6-B341-4DC7-A28A-A1E5293B8655} 0 2
  MARKER 20 151.5 "Speaker=Second Clown" 0 0 1 R {D1EF00BF-5883-4424-89F2-E641F04762F4} 0 2
  MARKER 9 152.5 "Entry=But is this law?" 1 21997311 1 R {D0CA2E59-5131-4F66-8A90-10E33517D1EC} 0 1
  MARKER 9 162.5 "" 1
  MARKER 21 166.5 "Speaker=First Clown" 0 0 1 R {295BAE4B-677B-4726-851B-1B5333F95C76} 0 2
  MARKER 22 166.5 "Speaker=First Clown" 0 0 1 R {CFCFE0E0-F200-4B50-9CCB-03444BF26652} 0 2
  MARKER 10 167.5 "Entry=Ay marry is't--crowner's quest law." 1 21997311 1 R {529E7007-1AFC-4A9F-9474-F71EAF076351} 0 1
  MARKER 10 177.5 "" 1
  MARKER 23 181.5 "Speaker=Second Clown" 0 0 1 R {3B94AFD7-C89F-45EA-92CE-F385D9DD33E5} 0 2
  MARKER 24 181.5 "Speaker=Second Clown" 0 0 1 R {741E2C15-7B2B-440E-83A4-E595E7FB954A} 0 2
  MARKER 11 182.5 "Entry=Will you ha' the truth on't? If this had not been a gentlewoman she should have been buried out o' Christian burial." 1 21997311 1 R {4C476D6F-DE19-410B-B98F-0351BDE45A0A} 0 1
  MARKER 11 192.5 "" 1
  MARKER 25 196.5 "Speaker=my spade." 0 0 1 R {A810170D-BC54-4EA7-B54C-B54D41C66B1C} 0 2
  MARKER 26 196.5 "Speaker=my spade." 0 0 1 R {32D77301-92FE-4753-9270-0BB84BC35C8A} 0 2
  MARKER 12 197.5 "Entry=Why there thou say'st: and the more pity that great folk should have countenance in this world to drown or hang themselves more than their even Christian. Come" 1 21997311 1 R {8521A49D-F2B9-4378-A24F-02A84C00EE17} 0 1
  MARKER 12 207.5 "" 1
  MARKER 27 211.5 "Speaker=Second Clown" 0 0 1 R {C2A0FF5F-2F22-41C0-93B5-3BC0E9615B9B} 0 2
  MARKER 28 211.5 "Speaker=Second Clown" 0 0 1 R {48E3363E-32EC-4FB7-9371-8A313A6980E4} 0 2
  MARKER 13 212.5 "Entry=Go to." 1 21997311 1 R {D7953D7A-77A4-4A24-8669-F8F096870E69} 0 1
  MARKER 13 222.5 "" 1
  MARKER 29 226.5 "Speaker=First Clown" 0 0 1 R {0C70D5D1-8453-453C-9848-BFA0B988082C} 0 2
  MARKER 30 226.5 "Speaker=First Clown" 0 0 1 R {527F5BCC-C906-4180-B5A3-892942229ECA} 0 2
  MARKER 14 227.5 "Entry=What is he that builds stronger than either the mason the shipwright or the carpenter?" 1 21997311 1 R {35121AA0-ADAA-4148-91F4-8A9A95256CBA} 0 1
  MARKER 14 237.5 "" 1
  MARKER 31 241.5 "Speaker=Second Clown" 0 0 1 R {6FA39A8A-9839-4B67-B014-717EF74555DA} 0 2
  MARKER 32 241.5 "Speaker=Second Clown" 0 0 1 R {F9D12E6E-61D9-426B-8A70-32C2600BB762} 0 2
  MARKER 15 242.5 "Entry=The gallows-maker; for that frame outlives a thousand tenants." 1 21997311 1 R {2B0F14C2-F8F2-4542-A1EA-8E441F0A102F} 0 1
  MARKER 15 252.5 "" 1
  MARKER 33 256.5 "Speaker=First Clown" 0 0 1 R {506F29C9-3ABF-4C02-8B70-F9E160F21081} 0 2
  MARKER 34 256.5 "Speaker=First Clown" 0 0 1 R {27F80786-F5F4-41D0-8E85-5D0D42297276} 0 2
  MARKER 16 257.5 "Entry=I like thy wit well in good faith: the gallows does well; but how does it well? it does well to those that do ill: now thou dost ill to say the gallows is built stronger than the church: argal the gallows may do well to thee." 1 21997311 1 R {60512B59-45E9-4184-8C81-A1D4786C7686} 0 1
  MARKER 16 267.5 "" 1
  MARKER 35 271.5 "Speaker=Second Clown" 0 0 1 R {A4D2F8D6-BD54-4607-9749-31653687EDC6} 0 2
  MARKER 36 271.5 "Speaker=Second Clown" 0 0 1 R {89F3B99B-0681-45CF-BA56-8A3F66DF56CA} 0 2
  MARKER 17 272.5 "Entry=Who builds stronger than a mason a shipwright or a carpenter?" 1 21997311 1 R {14755D4B-0B58-422D-81FB-065F1D2E8572} 0 1
  MARKER 17 282.5 "" 1
  MARKER 37 286.5 "Speaker=First Clown" 0 0 1 R {B341957E-F2EB-4E1B-8A72-DB5AEBDCC3DF} 0 2
  MARKER 38 286.5 "Speaker=First Clown" 0 0 1 R {70D2D600-8962-4990-9FF8-1D78229C40B0} 0 2
  MARKER 18 287.5 "Entry=Ay tell me that and unyoke." 1 21997311 1 R {67328A98-8F9E-414E-BAF4-DA3A69A1866C} 0 1
  MARKER 18 297.5 "" 1
  MARKER 39 301.5 "Speaker=Second Clown" 0 0 1 R {5E0739B5-8C8D-43E1-AE07-C98EFF4FD1DF} 0 2
  MARKER 40 301.5 "Speaker=Second Clown" 0 0 1 R {C7357F6C-75AA-4121-B1CE-0E2033EAC857} 0 2
  MARKER 19 302.5 "Entry=Marry now I can tell." 1 21997311 1 R {03FF3FE0-C70E-4C3E-BA0F-1BF1FE3C9995} 0 1
  MARKER 19 312.5 "" 1
  MARKER 41 316.5 "Speaker=First Clown" 0 0 1 R {EB89F304-BDC4-4FF0-8213-F5D9AC45B767} 0 2
  MARKER 42 316.5 "Speaker=First Clown" 0 0 1 R {6C1FA5ED-D3EE-4391-8C50-B0ADF804CA8D} 0 2
  MARKER 20 317.5 Entry=To't. 1 21997311 1 R {CCEF0271-E970-4068-B427-3807BD9730FE} 0 1
  MARKER 20 327.5 "" 1
  MARKER 43 331.5 "Speaker=Second Clown" 0 0 1 R {222046C5-0593-4E40-AE3A-F715E968D3B4} 0 2
  MARKER 44 331.5 "Speaker=Second Clown" 0 0 1 R {5FD45B8D-8A0B-4E89-88C3-051D8C2B6401} 0 2
  MARKER 21 332.5 "Entry=Mass I cannot tell." 1 21997311 1 R {0A0A259C-40C5-4402-AFCB-3688B3C5B724} 0 1
  MARKER 21 342.5 "" 1
  MARKER 45 346.5 "Speaker=First Clown" 0 0 1 R {EDFA0B68-D8E0-463E-81BD-8026E7E1FFD0} 0 2
  MARKER 46 346.5 "Speaker=First Clown" 0 0 1 R {7033F5C4-5042-4117-A643-B1FB5ADDED54} 0 2
  MARKER 22 347.5 "Entry=Cudgel thy brains no more about it for your dull ass will not mend his pace with beating; and when you are asked this question next say 'a grave-maker:' the houses that he makes last till doomsday." 1 21997311 1 R {FCDD2FC2-65FA-4003-BABB-43C113B72C59} 0 1
  MARKER 22 357.5 "" 1
  MARKER 47 361.5 "Speaker=Second Clown" 0 0 1 R {DE282906-6045-48D4-8B02-E61AED9A9FFA} 0 2
  MARKER 48 361.5 "Speaker=Second Clown" 0 0 1 R {9A27327E-AE70-47EA-A96C-E9E6583A838F} 0 2
  MARKER 23 362.5 "Entry=Go get thee to Yaughan; fetch me a stoup of liquor." 1 21997311 1 R {CA12D16C-3ECF-4774-A461-D9F2E12AD843} 0 1
  MARKER 23 372.5 "" 1
  MARKER 49 376.5 "Speaker=First Clown" 0 0 1 R {6B3A234D-039E-4D79-90A2-23E29A8EC88B} 0 2
  MARKER 50 376.5 "Speaker=First Clown" 0 0 1 R {EF54EDB2-56C0-49DB-A4A9-F6951CA6D47B} 0 2
  MARKER 24 377.5 "Entry=In youth when I did love did love methought it was very sweet; To contract O the time for ah my behove methought there was nothing meet." 1 21997311 1 R {286093D2-6E88-4B3D-80A8-CD4FDB3468EC} 0 1
  MARKER 24 387.5 "" 1
  MARKER 51 391.5 Speaker=Hamlet 0 0 1 R {B4014374-AA6A-49BD-8EFF-88D641D60935} 0 2
  MARKER 52 391.5 Speaker=Hamlet 0 0 1 R {A21E79BA-EFA2-4280-A137-DB35D4A864E3} 0 2
  MARKER 25 392.5 "Entry=Has this fellow no feeling of his business that he sings at grave-making?" 1 21997311 1 R {140CFD69-167A-4A6B-8E6A-1729A7DBE000} 0 1
  MARKER 25 402.5 "" 1
  MARKER 53 406.5 Speaker=Horatio 0 0 1 R {97936394-A75F-44CE-BAC0-45CEED2961A1} 0 2
  MARKER 54 406.5 Speaker=Horatio 0 0 1 R {9408463F-089E-443D-B9DF-BB3B54EAC7AB} 0 2
  MARKER 26 407.5 "Entry=Custom hath made it in him a property of easiness." 1 21997311 1 R {7619B9E9-F236-48AC-A89E-735A86E77A79} 0 1
  MARKER 26 417.5 "" 1
  MARKER 55 421.5 Speaker=Hamlet 0 0 1 R {BF5997A9-2111-4B3A-9A43-345A8F667CD1} 0 2
  MARKER 56 421.5 Speaker=Hamlet 0 0 1 R {1A7F8796-F010-4308-BA6C-CFA0E4E9812A} 0 2
  MARKER 27 422.5 "Entry='Tis e'en so: the hand of little employment hath the daintier sense." 1 21997311 1 R {F4DE40F8-9592-49B5-A3C9-F935197D7566} 0 1
  MARKER 27 432.5 "" 1
  MARKER 57 436.5 "Speaker=First Clown" 0 0 1 R {2013257C-73E3-4EE1-862C-7BEC8C721C2F} 0 2
  MARKER 58 436.5 "Speaker=First Clown" 0 0 1 R {7845C20A-8725-4C17-9B62-674883188575} 0 2
  MARKER 28 437.5 "Entry=But age with his stealing steps hath clawed me in his clutch; And hath shipped me intil the land as if I had never been such." 1 21997311 1 R {F3FD72C3-89BD-4832-844D-7780D08025F1} 0 1
  MARKER 28 447.5 "" 1
  MARKER 59 451.5 Speaker=Hamlet 0 0 1 R {7C2E1158-B3C6-4F7C-AB63-3AB34DD343CD} 0 2
  MARKER 60 451.5 Speaker=Hamlet 0 0 1 R {C63ED19D-A75E-4DD2-A099-0E83427B1771} 0 2
  MARKER 29 452.5 "Entry=That skull had a tongue in it and could sing once: how the knave jowls it to the ground as if it were Cain's jaw-bone that did the first murder!" 1 21997311 1 R {2F29B41B-E3C5-4268-91FC-9130ABDA4472} 0 1
  MARKER 29 462.5 "" 1
  MARKER 61 466.5 Speaker=Hamlet 0 0 1 R {7312C2C9-CE45-4B59-A7D0-820B630DADF2} 0 2
  MARKER 62 466.5 Speaker=Hamlet 0 0 1 R {00D34DDC-7111-4FE9-80E1-BF589CB40C55} 0 2
  MARKER 30 467.5 "Entry=It might be the pate of a politician which this ass now o'erreaches; one that would circumvent God might it not?" 1 21997311 1 R {5DACEF70-58CE-4C44-AEEE-48D822BF8B34} 0 1
  MARKER 30 477.5 "" 1
  MARKER 63 481.5 Speaker=Horatio 0 0 1 R {3D1B6D83-BD3D-4B71-A7D5-5DC1AA8A8B0C} 0 2
  MARKER 64 481.5 Speaker=Horatio 0 0 1 R {532E78E5-81A3-45AC-AE6E-040FE9AE74FF} 0 2
  MARKER 31 482.5 "Entry=It might my lord." 1 21997311 1 R {A623EDFD-5EA7-40C9-810D-78E9440BA289} 0 1
  MARKER 31 492.5 "" 1
  MARKER 65 496.5 Speaker=Hamlet 0 0 1 R {62A338F0-2AFD-46EB-856C-8D6382DAEEF7} 0 2
  MARKER 66 496.5 Speaker=Hamlet 0 0 1 R {8C96DFA5-13B0-468B-9801-93CA92DCA5F0} 0 2
  MARKER 32 497.5 "Entry=Or of a courtier which could say 'Good morrow sweet lord! How dost thou sweet lord?' This might be my lord such-a-one that praised my lord such-a-one's horse when he meant to beg it--might it not?" 1 21997311 1 R {49497DD1-7F87-4204-81E8-DDD4C16D826C} 0 1
  MARKER 32 507.5 "" 1
  MARKER 67 511.5 Speaker=Horatio 0 0 1 R {7A2D024F-711E-4D21-9588-479235CCDDF9} 0 2
  MARKER 68 511.5 Speaker=Horatio 0 0 1 R {EE1A627D-5A6B-40C3-81B3-A57DFF77E1FE} 0 2
  MARKER 33 512.5 "Entry=Ay my lord." 1 21997311 1 R {4EB1B535-563D-423E-A483-568CDB593DF0} 0 1
  MARKER 33 522.5 "" 1
  MARKER 69 526.5 Speaker=Hamlet 0 0 1 R {D11D322D-9812-42BD-AC02-ADDD60AB80F1} 0 2
  MARKER 70 526.5 Speaker=Hamlet 0 0 1 R {5113B531-B89C-47D9-9665-7FBFF3B772E7} 0 2
  MARKER 34 527.5 "Entry=Why e'en so: and now my Lady Worm's chapless and knocked about the mazard with a sexton's spade: here's fine revolution an we had the trick to see't." 1 21997311 1 R {4A356504-2DED-49D5-87F7-81E33FEAA7FA} 0 1
  MARKER 34 537.5 "" 1
  MARKER 71 541.5 Speaker=Hamlet 0 0 1 R {4A2C8B08-9039-48B0-AE41-DF81568B8266} 0 2
  MARKER 72 541.5 Speaker=Hamlet 0 0 1 R {27A3C959-065F-4D27-AA88-58EBEBAEF501} 0 2
  MARKER 35 542.5 "Entry=Did these bones cost no more the breeding but to play at loggats with 'em? mine ache to think on't." 1 21997311 1 R {87F97E4D-256C-4171-8302-AE7B7F60F671} 0 1
  MARKER 35 552.5 "" 1
  MARKER 73 556.5 "Speaker=First Clown" 0 0 1 R {653A204F-A3D9-4E02-BB83-090C673F811E} 0 2
  MARKER 74 556.5 "Speaker=First Clown" 0 0 1 R {3F37EC53-71B2-4C9A-A6CF-A5DE731FD5A4} 0 2
  MARKER 36 557.5 "Entry=A pick-axe and a spade a spade; For and a shrouding sheet: O a pit of clay for to be made For such a guest is meet." 1 21997311 1 R {BECA29B2-F8C8-4D98-A91E-7760E8016499} 0 1
  MARKER 36 567.5 "" 1
  MARKER 75 571.5 Speaker=Hamlet 0 0 1 R {B4308628-F68D-4A8F-9C92-C1EC0DDD3064} 0 2
  MARKER 76 571.5 Speaker=Hamlet 0 0 1 R {4A238B5F-44A6-45EA-9EDE-E2A0E896D0B6} 0 2
  MARKER 37 572.5 "Entry=There's another: why may not that be the skull of a lawyer? Where be his quiddits now his quillets his cases his tenures and his tricks?" 1 21997311 1 R {FC23E94C-00B7-4890-A2FE-DAB30EFB1568} 0 1
  MARKER 37 582.5 "" 1
  MARKER 77 586.5 Speaker=Horatio 0 0 1 R {F3EA7F0B-B7F7-44DE-AB8C-29633149E7F4} 0 2
  MARKER 78 586.5 Speaker=Horatio 0 0 1 R {DE5153B0-C053-4F3A-94D8-AABEF2F1E3B4} 0 2
  MARKER 38 587.5 "Entry=What's that his honour?" 1 21997311 1 R {89028B44-01C7-4B86-98C5-1AEEC653B52E} 0 1
  MARKER 38 597.5 "" 1
  MARKER 79 601.5 Speaker=Hamlet 0 0 1 R {ED89D11C-CCBB-4254-9593-04DCFA4907E6} 0 2
  MARKER 80 601.5 Speaker=Hamlet 0 0 1 R {5380E8DF-4EFC-4F58-9573-F92C71BCB513} 0 2
  MARKER 39 602.5 "Entry=Is not this something more than fantasy? Think on that." 1 21997311 1 R {2A1AB137-19C0-44B4-B432-BCEDA0A5D5A9} 0 1
  MARKER 39 612.5 "" 1
  MARKER 81 616.5 "Speaker=First Clown" 0 0 1 R {252490D8-5438-4819-B6A8-922A0E771AB2} 0 2
  MARKER 82 616.5 "Speaker=First Clown" 0 0 1 R {6A2DA06C-023D-40A7-BDD8-F7332B4344C1} 0 2
  MARKER 40 617.5 "Entry=Here lies the water; good: here stands the man; good: if the man go to this water and drown himself--" 1 21997311 1 R {84DD528D-85E0-4EFD-98EB-D76A0EA64CA6} 0 1
  MARKER 40 627.5 "" 1
  MARKER 83 631.5 Speaker=Hamlet 0 0 1 R {8BBCEFD7-428A-446F-8DD0-D566277B57E7} 0 2
  MARKER 84 631.5 Speaker=Hamlet 0 0 1 R {5A2A1EC6-1747-4385-BDB2-930BB0B2CEBD} 0 2
  MARKER 41 632.5 "Entry=This doth well for these--but what of this man's picture? Look you." 1 21997311 1 R {3FB3AC97-A95A-409A-BD6F-E6B5B9F06847} 0 1
  MARKER 41 642.5 "" 1
  MARKER 85 646.5 Speaker=Hamlet 0 0 1 R {56A4B886-2DEA-472A-A891-FE2209E89954} 0 2
  MARKER 86 646.5 Speaker=Hamlet 0 0 1 R {DB833985-6A8D-4AD1-AACD-06EAD06B93F7} 0 2
  MARKER 42 647.5 "Entry=The very conveyances of his lands will hardly lie in this box; and must the inheritor himself have no more, ha?" 1 21997311 1 R {7D5F4070-95E5-4445-A73C-6EFE13702024} 0 1
  MARKER 42 657.5 "" 1
  MARKER 87 661.5 Speaker=Horatio 0 0 1 R {DACC8FDC-124F-48A2-86DA-204FE51FB6D4} 0 2
  MARKER 88 661.5 Speaker=Horatio 0 0 1 R {2151987E-D393-402D-BDE6-B0B90AE1D95E} 0 2
  MARKER 43 662.5 "Entry=Not a jot more my lord." 1 21997311 1 R {AA2C5A6F-57E5-4F5A-A0FB-39E28F371D9C} 0 1
  MARKER 43 672.5 "" 1
  MARKER 89 676.5 Speaker=Hamlet 0 0 1 R {6E179439-A11C-468D-9636-ACBBF2A1E85F} 0 2
  MARKER 90 676.5 Speaker=Hamlet 0 0 1 R {68C69633-67BD-45C4-9D54-31B9812D982C} 0 2
  MARKER 44 677.5 "Entry=Is not parchment made of sheep-skins?" 1 21997311 1 R {FABD29D8-B685-4E3F-9C5B-F280D25AB5ED} 0 1
  MARKER 44 687.5 "" 1
  MARKER 91 691.5 Speaker=Horatio 0 0 1 R {943642D1-7714-4DA5-8D0B-DFD5D90E9E51} 0 2
  MARKER 92 691.5 Speaker=Horatio 0 0 1 R {D77BFEC0-F837-401E-B7EA-5CD87AE5AB9F} 0 2
  MARKER 45 692.5 "Entry=Ay my lord And of calves-skins too." 1 21997311 1 R {EC68AC20-9DD8-4792-9295-F8E98CE8DD9C} 0 1
  MARKER 45 702.5 "" 1
  MARKER 93 706.5 Speaker=Hamlet 0 0 1 R {BB3622B1-85D6-4CDD-92D2-96030364DAB0} 0 2
  MARKER 94 706.5 Speaker=Hamlet 0 0 1 R {EA963763-62CB-4760-B882-D1080D5DFE42} 0 2
  MARKER 46 707.5 "Entry=Those are sheep and calves which seek out assurance in that. I will speak to this fellow.--Whose grave's this sirrah?" 1 21997311 1 R {9F1C3DD5-2746-4AE7-BBD9-B30685800E40} 0 1
  MARKER 46 717.5 "" 1
  MARKER 95 721.5 "Speaker=First Clown" 0 0 1 R {0DA71AF0-5707-44D0-8B8B-9E6113685B97} 0 2
  MARKER 96 721.5 "Speaker=First Clown" 0 0 1 R {F96BB755-A975-4499-953D-3D637A39154B} 0 2
  MARKER 47 722.5 "Entry=Mine sir." 1 21997311 1 R {31D415EF-6344-4ECE-A5FB-225336AA6BFA} 0 1
  MARKER 47 732.5 "" 1
  MARKER 97 736.5 Speaker=Hamlet 0 0 1 R {81022278-F53E-483C-A801-388AF48C5840} 0 2
  MARKER 98 736.5 Speaker=Hamlet 0 0 1 R {0A28989F-37CE-485A-A3C5-999A5430594C} 0 2
  MARKER 48 737.5 "Entry=I think it be thine indeed; for thou liest in't." 1 21997311 1 R {382498B7-089F-4F6F-B1E9-E9F13CD98963} 0 1
  MARKER 48 747.5 "" 1
  MARKER 99 751.5 "Speaker=First Clown" 0 0 1 R {9ED793CF-C74C-4DC9-8109-B7C2F43C5CE7} 0 2
  MARKER 100 751.5 "Speaker=First Clown" 0 0 1 R {A43FDD8B-240B-44BF-8546-E827D21EC008} 0 2
  MARKER 49 752.5 "Entry=You lie out on't sir and therefore it is not yours: for my part I do not lie in't." 1 21997311 1 R {C0CA20BE-5136-4E5D-B17F-7019BB4E180D} 0 1
  MARKER 49 762.5 "" 1
  MARKER 101 766.5 Speaker=Hamlet 0 0 1 R {11A526C4-9409-497E-944D-3A45AC50CAAF} 0 2
  MARKER 102 766.5 Speaker=Hamlet 0 0 1 R {FFA0241B-D003-4E34-818A-0EB51DE266E1} 0 2
  MARKER 50 767.5 "Entry='Tis a quick lie sir; 'twill away gain from me to you." 1 21997311 1 R {0D29ED7E-97E0-4319-B6C7-9BC1DB7679DF} 0 1
  MARKER 50 777.5 "" 1
  MARKER 103 781.5 Speaker=Hamlet 0 0 1 R {61E78181-1394-4167-AADB-B31DAC56F689} 0 2
  MARKER 104 781.5 Speaker=Hamlet 0 0 1 R {8F7281CF-7DFA-4DAB-9DA0-AE59512F6424} 0 2
  MARKER 51 782.5 "Entry=What man dost thou dig it for?" 1 21997311 1 R {CC55C772-103E-48EF-B31D-58085B81B7FA} 0 1
  MARKER 51 792.5 "" 1
  MARKER 105 796.5 "Speaker=First Clown" 0 0 1 R {6E5428F7-4D01-4F38-BC3C-687CBC258307} 0 2
  MARKER 106 796.5 "Speaker=First Clown" 0 0 1 R {9C5F6C36-3CE7-462F-AA92-2CE073E1D49C} 0 2
  MARKER 52 797.5 "Entry=For no man madam." 1 21997311 1 R {6E753FBF-CE11-4770-9E85-A5B19090DA1D} 0 1
  MARKER 52 807.5 "" 1
  MARKER 107 811.5 Speaker=Hamlet 0 0 1 R {8A6704B2-EBCD-40B6-A698-D881971FFF07} 0 2
  MARKER 108 811.5 Speaker=Hamlet 0 0 1 R {48054814-1F4A-494C-A53D-75C830FDD4E3} 0 2
  MARKER 53 812.5 "Entry=What woman then?" 1 21997311 1 R {BDA84BE8-4C4C-4595-9E57-350154FE3A98} 0 1
  MARKER 53 822.5 "" 1
  MARKER 109 826.5 "Speaker=First Clown" 0 0 1 R {E75FDFDC-9691-4986-AD85-D0D44485DF94} 0 2
  MARKER 110 826.5 "Speaker=First Clown" 0 0 1 R {638301B9-BF0C-499D-A9D9-341C2B6D7E20} 0 2
  MARKER 54 827.5 "Entry=For none neither." 1 21997311 1 R {26828CB6-8122-41A6-89E6-72988D9FE87A} 0 1
  MARKER 54 837.5 "" 1
  MARKER 111 841.5 Speaker=Hamlet 0 0 1 R {5ABB3C66-145A-4446-8F04-CE28A0A1687D} 0 2
  MARKER 112 841.5 Speaker=Hamlet 0 0 1 R {07836A38-04D1-46BC-BA41-E8B9FEC3CE46} 0 2
  MARKER 55 842.5 "Entry=Who is to be buried in't?" 1 21997311 1 R {2F8D6FDA-43A9-4774-8385-7175EAD9F0E3} 0 1
  MARKER 55 852.5 "" 1
  MARKER 113 856.5 "Speaker=First Clown" 0 0 1 R {DF48399A-FB06-4CDE-8EE5-8DE7AD0A5227} 0 2
  MARKER 114 856.5 "Speaker=First Clown" 0 0 1 R {ABF3BFEE-3B80-42EA-9947-A3552E802F45} 0 2
  MARKER 56 857.5 "Entry=One that was a woman sir; but rest her soul she's dead." 1 21997311 1 R {58B2A49D-BD8B-4F7D-9E81-3A6ABB4E83A3} 0 1
  MARKER 56 867.5 "" 1
  MARKER 115 871.5 Speaker=Hamlet 0 0 1 R {1B556F6E-F3F0-4711-A769-B11DA4059B3C} 0 2
  MARKER 116 871.5 Speaker=Hamlet 0 0 1 R {4FC05720-357B-464D-8F7A-F91B2663F53F} 0 2
  MARKER 57 872.5 "Entry=How absolute the knave is! we must speak by the card or equivocation will undo us." 1 21997311 1 R {148798EE-1865-4786-8CDE-6C96B65063AB} 0 1
  MARKER 57 882.5 "" 1
  MARKER 117 886.5 Speaker=Hamlet 0 0 1 R {FEB661B6-9464-462E-A4E1-D54F3697D764} 0 2
  MARKER 118 886.5 Speaker=Hamlet 0 0 1 R {ECB0B7DE-7107-4CB6-A611-1CB57773D191} 0 2
  MARKER 58 887.5 "Entry=By the Lord Horatio these three years I have taken note of it; the age is grown so picked that the toe of the peasant comes so near the heel of the courtier he galls his kibe." 1 21997311 1 R {C72F69D1-9A0F-4E41-A3B5-75E02AE1ED3F} 0 1
  MARKER 58 897.5 "" 1
  MARKER 119 901.5 Speaker=Hamlet 0 0 1 R {8F3BFB2C-0214-42C7-9169-28E403F61FF3} 0 2
  MARKER 120 901.5 Speaker=Hamlet 0 0 1 R {A3395553-6539-498F-AB51-9525BF7599F3} 0 2
  MARKER 59 902.5 "Entry=How long hast thou been a grave-maker?" 1 21997311 1 R {6BC55781-AB08-47C7-8D5F-F4CD3EE26FC1} 0 1
  MARKER 59 912.5 "" 1
  MARKER 121 916.5 "Speaker=First Clown" 0 0 1 R {24538576-8218-4CA9-95CA-9F62021AC6C2} 0 2
  MARKER 122 916.5 "Speaker=First Clown" 0 0 1 R {EAEBCFA6-00F2-4200-8BB1-543EDC605B77} 0 2
  MARKER 60 917.5 "Entry=Of all the days i' the year I came to't that day that our last king Hamlet o'ercame Fortinbras." 1 21997311 1 R {8D7A8864-A117-4EA6-9C3D-3FC596B632A5} 0 1
  MARKER 60 927.5 "" 1
  MARKER 123 931.5 Speaker=Hamlet 0 0 1 R {E82A5B72-9E6C-4601-BD93-15AD021089CD} 0 2
  MARKER 124 931.5 Speaker=Hamlet 0 0 1 R {2697DD66-3125-4AC1-A45B-E3EE424BF6D1} 0 2
  MARKER 61 932.5 "Entry=How long is that since?" 1 21997311 1 R {8B0ED57C-865B-40CC-8AB3-46DA0AD0978A} 0 1
  MARKER 61 942.5 "" 1
  MARKER 125 946.5 "Speaker=First Clown" 0 0 1 R {7F3B3952-65FF-465A-9A43-E0A2B43A6DC2} 0 2
  MARKER 126 946.5 "Speaker=First Clown" 0 0 1 R {A427BEAE-AB36-4960-9803-81829C73E4AE} 0 2
  MARKER 62 947.5 "Entry=Cannot you tell that? every fool can tell that: it was the very day that young Hamlet was born--" 1 21997311 1 R {E68A29DC-F597-4DF8-9E24-D4EE90DA4B7B} 0 1
  MARKER 62 957.5 "" 1
  MARKER 127 961.5 "Speaker=First Clown" 0 0 1 R {6A7677AB-27D9-4B12-82F5-121C931A76AA} 0 2
  MARKER 128 961.5 "Speaker=First Clown" 0 0 1 R {1BA5C59F-A2CD-4B14-83E3-51B23EB5AD3A} 0 2
  MARKER 63 962.5 "Entry=I' faith if he be not rotten before he die--" 1 21997311 1 R {82EDA275-A4EA-4168-8AE0-7BC0BAAA0EDB} 0 1
  MARKER 63 972.5 "" 1
  MARKER 129 976.5 Speaker=Hamlet 0 0 1 R {E33E338D-CBF4-49AF-A130-F6444FA8DCB3} 0 2
  MARKER 130 976.5 Speaker=Hamlet 0 0 1 R {BC7DA7B2-73C8-4657-A605-4A1640EFCB0D} 0 2
  MARKER 64 977.5 "Entry=Ha! ha! ha!--" 1 21997311 1 R {5E0CDEBF-1E0C-4AC3-94F1-54CFA5C3AED2} 0 1
  MARKER 64 987.5 "" 1
  MARKER 131 991.5 "Speaker=First Clown" 0 0 1 R {3241DC8B-FA2C-438F-9995-8D754B246B38} 0 2
  MARKER 132 991.5 "Speaker=First Clown" 0 0 1 R {DEE76143-2277-4B72-8044-2C83B0A7A9B0} 0 2
  MARKER 65 992.5 "Entry=--we shall have him a piece of a carrion: Lord an he had lain i' the ground two years he would not have smelled." 1 21997311 1 R {A26A914B-01AB-4371-BED5-60432F60CD99} 0 1
  MARKER 65 1002.5 "" 1
  MARKER 133 1006.5 Speaker=Hamlet 0 0 1 R {1D4FF9B2-8E2D-4D28-B9A0-AE47C94F9C8D} 0 2
  MARKER 134 1006.5 Speaker=Hamlet 0 0 1 R {FFB426F6-C92C-4245-AAF5-7F2379E5CEDD} 0 2
  MARKER 66 1007.5 "Entry=How came he mad?" 1 21997311 1 R {C52A6665-8F75-4C2A-B92A-BAE352F6A4A2} 0 1
  MARKER 66 1017.5 "" 1
  MARKER 135 1021.5 "Speaker=First Clown" 0 0 1 R {504DB7C9-3C33-413E-A604-C13F5BF21647} 0 2
  MARKER 136 1021.5 "Speaker=First Clown" 0 0 1 R {3E624642-0732-409C-AAD0-F71178ABE50B} 0 2
  MARKER 67 1022.5 "Entry=Very strangely by a kind of madness." 1 21997311 1 R {1E24FE4F-D868-45E0-BBB7-72467C0BFE8F} 0 1
  MARKER 67 1032.5 "" 1
  MARKER 137 1036.5 Speaker=Hamlet 0 0 1 R {670CD027-6DAB-435E-BD41-82ECA4EA21A3} 0 2
  MARKER 138 1036.5 Speaker=Hamlet 0 0 1 R {63318B09-C007-4D4A-A873-8ACE6DF16C07} 0 2
  MARKER 68 1037.5 "Entry=Of what?" 1 21997311 1 R {40E1BF4B-7248-4F00-A666-BBC53A868E6E} 0 1
  MARKER 68 1047.5 "" 1
  MARKER 139 1051.5 "Speaker=First Clown" 0 0 1 R {CDDAB326-011D-4918-89EE-EC4E3EED583A} 0 2
  MARKER 140 1051.5 "Speaker=First Clown" 0 0 1 R {11C55565-5752-4C9A-8CD9-B45108C9FE65} 0 2
  MARKER 69 1052.5 "Entry=Why here in Denmark: I have been sexton here man and boy thirty years." 1 21997311 1 R {60A7790C-5E7C-4E56-A66A-0C0D5D8183A8} 0 1
  MARKER 69 1062.5 "" 1
  MARKER 141 1066.5 Speaker=Hamlet 0 0 1 R {1D4B28F9-2714-435D-858D-540EABFD73CE} 0 2
  MARKER 142 1066.5 Speaker=Hamlet 0 0 1 R {28E02B3D-5544-4762-BDA5-C80D965FF1BB} 0 2
  MARKER 70 1067.5 "Entry=How long will a man lie i' the earth ere he rot?" 1 21997311 1 R {4803EC43-6FE2-46AE-B69B-06C61D8862BC} 0 1
  MARKER 70 1077.5 "" 1
  MARKER 143 1081.5 "Speaker=First Clown" 0 0 1 R {8A6AE866-C198-4BBF-A680-08EB49996680} 0 2
  MARKER 144 1081.5 "Speaker=First Clown" 0 0 1 R {79B797E6-DE72-468B-B157-94D249AABFE5} 0 2
  MARKER 71 1082.5 "Entry=Faith if he be not rotten before he die--and we have many pocky corses now-a-days that will scarce hold the laying in--" 1 21997311 1 R {E40B0A56-48CB-4DF7-B426-A7584CB602D5} 0 1
  MARKER 71 1092.5 "" 1
  MARKER 145 1096.5 Speaker=Hamlet 0 0 1 R {2BA3D1D5-9423-4D48-A9E4-68C9AAAA3E51} 0 2
  MARKER 146 1096.5 Speaker=Hamlet 0 0 1 R {8353D545-2321-4FE6-96F1-80504C49472D} 0 2
  MARKER 72 1097.5 "Entry=He must build churches then." 1 21997311 1 R {C7BE2F88-81AA-4E4C-9A51-D72D59CE1634} 0 1
  MARKER 72 1107.5 "" 1
  MARKER 147 1111.5 "Speaker=First Clown" 0 0 1 R {CA1354B6-A7CC-4CDD-A95F-952F20E17FDC} 0 2
  MARKER 148 1111.5 "Speaker=First Clown" 0 0 1 R {31EF8D54-9E47-4E1A-A321-2787420E5839} 0 2
  MARKER 73 1112.5 "Entry=No I tell thee he will keep no mean in the talking to himself: words words words." 1 21997311 1 R {03B6F314-DFAD-4DC2-94DE-B158316A7230} 0 1
  MARKER 73 1122.5 "" 1
  MARKER 149 1126.5 Speaker=Hamlet 0 0 1 R {186FD824-D629-4DF6-83DA-B2A7E5B64E45} 0 2
  MARKER 150 1126.5 Speaker=Hamlet 0 0 1 R {6E07C25D-8C82-4A7F-9A68-38887A99AAB7} 0 2
  MARKER 74 1127.5 "Entry=Alas poor Yorick! I knew him Horatio: a fellow of infinite jest of most excellent fancy." 1 21997311 1 R {ADD8BB8E-42E7-4698-876C-97936CAAFFCC} 0 1
  MARKER 74 1137.5 "" 1
  MARKER 151 1141.5 Speaker=Hamlet 0 0 1 R {A6427631-04BF-4F59-8B68-217F95D6393E} 0 2
  MARKER 152 1141.5 Speaker=Hamlet 0 0 1 R {8EF482C0-43B4-4259-86F0-8479E4F6C6A4} 0 2
  MARKER 75 1142.5 "Entry=He hath borne me on his back a thousand times; and now how abhorred in my imagination it is!" 1 21997311 1 R {189A9FEB-F1EF-4125-96AC-4EBB04A8E5E1} 0 1
  MARKER 75 1152.5 "" 1
  MARKER 153 1156.5 Speaker=Hamlet 0 0 1 R {4931A956-F13A-44B2-B9B9-6A2B74D77D0E} 0 2
  MARKER 154 1156.5 Speaker=Hamlet 0 0 1 R {AFF13C74-70E3-473E-8F94-7763F9A93A68} 0 2
  MARKER 76 1157.5 "Entry=My gorge rises at it. Here hung those lips that I have kissed I know not how oft." 1 21997311 1 R {E1F1BA18-2C0C-4A06-8AB5-EC397F451E4B} 0 1
  MARKER 76 1167.5 "" 1
  MARKER 155 1171.5 Speaker=Hamlet 0 0 1 R {C49B7DC5-867C-441C-A552-26ABBE683FCB} 0 2
  MARKER 156 1171.5 Speaker=Hamlet 0 0 1 R {5D567979-B4FB-4786-92A7-DE0E8901E7AD} 0 2
  MARKER 77 1172.5 "Entry=Where be your gibes now? your gambols? your songs? your flashes of merriment that were wont to set the table on a roar?" 1 21997311 1 R {C106DCAF-3015-473F-9C37-6C977A0EB2C5} 0 1
  MARKER 77 1182.5 "" 1
  MARKER 157 1186.5 Speaker=Hamlet 0 0 1 R {45FAF62F-61DD-4361-B74F-8DDE70F84990} 0 2
  MARKER 158 1186.5 Speaker=Hamlet 0 0 1 R {74FCB2F3-1BB5-437B-8B4E-18A802356214} 0 2
  MARKER 78 1187.5 "Entry=Not one now to mock your own grinning? quite chap-fallen? Now get you to my lady's chamber and tell her let her paint an inch thick to this favour she must come; make her laugh at that." 1 21997311 1 R {F4B26DA1-B0A0-45F6-ACE5-D5DEDB7F69DF} 0 1
  MARKER 78 1197.5 "" 1
  MARKER 159 1201.5 Speaker=Hamlet 0 0 1 R {BDA3B0C5-942C-4A22-898B-B5C62BE3DADB} 0 2
  MARKER 160 1201.5 Speaker=Hamlet 0 0 1 R {6789EE2A-6EAB-4A1C-9A41-48E3018C28AA} 0 2
  MARKER 79 1202.5 "Entry=Prithee Horatio tell me one thing." 1 21997311 1 R {95CD0AB0-5A6F-4AB8-91E2-CFB7CFE3D0B7} 0 1
  MARKER 79 1212.5 "" 1
  MARKER 161 1216.5 Speaker=Horatio 0 0 1 R {F90CB1FF-9E44-4091-9516-AB4125595063} 0 2
  MARKER 162 1216.5 Speaker=Horatio 0 0 1 R {94E21D31-0A93-47D5-86E0-12EA38540626} 0 2
  MARKER 80 1217.5 "Entry=What's that my lord?" 1 21997311 1 R {C9820BFB-2D90-47E2-AAF6-2A0D6BC63D1A} 0 1
  MARKER 80 1227.5 "" 1
  MARKER 163 1231.5 Speaker=Hamlet 0 0 1 R {DD9AB1FE-369E-4081-9982-9C1AD707C787} 0 2
  MARKER 164 1231.5 Speaker=Hamlet 0 0 1 R {C93B880F-EBC2-4461-9289-4A5837236182} 0 2
  MARKER 81 1232.5 "Entry=Dost thou think Alexander looked o' this fashion i' the earth?" 1 21997311 1 R {4DD0D3DF-358C-4875-9E1A-04A21CB4FB23} 0 1
  MARKER 81 1242.5 "" 1
  MARKER 165 1246.5 Speaker=Horatio 0 0 1 R {530748E7-A816-4585-80C1-F15BFFC572F3} 0 2
  MARKER 166 1246.5 Speaker=Horatio 0 0 1 R {79C7A202-B501-4478-8CC6-5B84256CC134} 0 2
  MARKER 82 1247.5 "Entry=E'en so." 1 21997311 1 R {9F8FE355-9678-4A6C-8ED5-B2298A092D66} 0 1
  MARKER 82 1257.5 "" 1
  MARKER 167 1261.5 Speaker=Hamlet 0 0 1 R {8F89DF6C-EFF8-4FFD-8204-8209C263BE7F} 0 2
  MARKER 168 1261.5 Speaker=Hamlet 0 0 1 R {50683462-7DB8-465F-A9AE-5201B62A0590} 0 2
  MARKER 83 1262.5 "Entry=To what base uses we may return Horatio! Why may not imagination trace the noble dust of Alexander till he find it stopping a bunghole?" 1 21997311 1 R {A69F9D1E-2FA7-4B04-B6D1-A9C92D44C59B} 0 1
  MARKER 83 1272.5 "" 1
  MARKER 169 1276.5 Speaker=Horatio 0 0 1 R {E327B964-6091-46AA-8452-2639F074914F} 0 2
  MARKER 170 1276.5 Speaker=Horatio 0 0 1 R {54FC561C-F6CC-470E-8B94-4074629A25C0} 0 2
  MARKER 84 1277.5 "Entry='Twere to consider too curiously to consider so." 1 21997311 1 R {C4BC0D3D-673D-43B0-82B6-FF5A1339BE5C} 0 1
  MARKER 84 1287.5 "" 1
  MARKER 171 1291.5 Speaker=Hamlet 0 0 1 R {007E61D9-0AD9-4566-BA7A-BA83583E189A} 0 2
  MARKER 172 1291.5 Speaker=Hamlet 0 0 1 R {503520FE-0C80-4E5A-B38F-7707728717A4} 0 2
  MARKER 85 1292.5 "Entry=No faith not a jot; but to follow him thither with modesty enough and likelihood to lead it: as thus: Alexander died Alexander was buried Alexander returneth into dust; the dust is earth; of earth we make loam; and why of that loam whereto he was converted might they not stop a beer-barrel?" 1 21997311 1 R {05FE2039-6AC9-46A4-B783-1D8AB779010F} 0 1
  MARKER 85 1302.5 "" 1
